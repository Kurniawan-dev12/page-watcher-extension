{
  "manifest_version": 3,
  "name": "Page Watcher – Web Change Alerts",
  "short_name": "Page Watcher",
  "version": "1.0.0",
  "description": "Watch any number or text on a web page and get a Telegram or desktop alert when it changes.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Page Watcher",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": ["storage", "alarms", "notifications", "scripting", "activeTab", "offscreen"],
  "host_permissions": ["<all_urls>"]
}
